# Runs the headless phase-0 chain: new -> sculpt (with multires) -> subdivide -> check ->
# convert -> voxel remesh -> decimate -> unwrap -> bake, checking printability along the
# way and decoding the baked PNG/EXR files independently when Python is available.
file(MAKE_DIRECTORY ${WORK})
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  message(STATUS "${out}${err}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "command failed (${rc}): ${ARGV}")
  endif()
endfunction()
run(${CLI} new sphere ${WORK}/base.obj --levels 4)
run(${CLI} sculpt ${WORK}/base.obj ${SCRIPT} ${WORK}/sculpted.ply)
run(${CLI} subdivide ${WORK}/sculpted.ply ${WORK}/smooth.obj --levels 1)
run(${CLI} check ${WORK}/smooth.obj)
run(${CLI} convert ${WORK}/smooth.obj ${WORK}/smooth.stl)
run(${CLI} check ${WORK}/smooth.stl --json)
run(${CLI} remesh ${WORK}/smooth.obj ${WORK}/remeshed.obj --resolution 96)
run(${CLI} check ${WORK}/remeshed.obj)
run(${CLI} decimate ${WORK}/remeshed.obj ${WORK}/low.obj --target 5000)
run(${CLI} check ${WORK}/low.obj)
run(${CLI} quadremesh ${WORK}/smooth.obj ${WORK}/quads.obj --faces 3000)
run(${CLI} check ${WORK}/quads.obj)
run(${CLI} subdivide ${WORK}/quads.obj ${WORK}/quads_sub.obj)
run(${CLI} unwrap ${WORK}/low.obj ${WORK}/low_uv.obj --resolution 256)
run(${CLI} unwrap ${WORK}/quads.obj ${WORK}/quads_uv.obj --resolution 256)
run(${CLI} bake ${WORK}/quads_uv.obj ${WORK}/smooth.obj ${WORK}/quadhead --resolution 128 --maps normal,height)
run(${CLI} bake ${WORK}/low_uv.obj ${WORK}/smooth.obj ${WORK}/head --resolution 256 --maps normal,height,vdm,ao --ao-samples 8)
if(PYTHON)
  file(GLOB maps ${WORK}/head_*)
  run(${PYTHON} ${CHECKER} ${maps})
endif()
