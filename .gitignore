# Builds
/build*/
/out/
compile_commands.json

# Xcode (the project is generated by XcodeGen from shell-ipad/project.yml)
shell-ipad/*.xcodeproj/
shell-ipad/*.xcworkspace/
DerivedData/
xcuserdata/
*.xcuserstate
# Personal signing (team ID, bundle ID) for running on a device; see docs/SETUP.md
shell-ipad/Signing.local.xcconfig

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.DS_Store

# Claude Code agent worktrees
.claude/worktrees/
